    if cb3.button("🌐 Revisar Firewall / Web", use_container_width=True):
        prompt_rapido = "Analiza las peticiones prohibidas HTTP 403 y determina si hubo un escaneo de rutas."

    st.markdown("---")
    if "messages" not in st.session_state:
        st.session_state.messages = [{"role": "assistant", "content": "👋 **Hola, soy el Asistente SOC Tier 3 de Colmena Technologies.** ¿Qué incidente procedemos a investigar hoy?"}]

    for m in st.session_state.messages:
        with st.chat_message(m["role"]):
            st.markdown(m["content"])

    user_input = st.chat_input("Escribe tu pregunta de análisis...", key="soc_main_input")
    final_prompt = prompt_rapido if prompt_rapido else user_input

    if final_prompt:
        st.session_state.messages.append({"role": "user", "content": final_prompt})
        with st.chat_message("user"):
            st.markdown(final_prompt)
        with st.chat_message("assistant"):
