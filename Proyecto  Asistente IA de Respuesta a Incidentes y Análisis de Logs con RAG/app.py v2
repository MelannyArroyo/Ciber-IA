    cb1, cb2, cb3 = st.columns(3)
    prompt_rapido = None
    if cb1.button("🚨 Investigar IP 192.168.1.50", use_container_width=True):
        prompt_rapido = "Realiza un informe forense detallado de la IP 192.168.1.50 incluyendo línea de tiempo y MITRE ATT&CK."
    if cb2.button("🔑 Analizar fuerza bruta Root", use_container_width=True):
