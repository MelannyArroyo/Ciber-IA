                resp = analizar_incidentes_con_gemini(final_prompt)
                st.markdown(resp)
                st.session_state.messages.append({"role": "assistant", "content": resp})

with tab_analytics:
    st.markdown("##### 📈 Analítica Visual de Incidentes")
    if collection:
        try:
            raw_data = collection.get()
            if raw_data and raw_data.get("metadatas"):
                df_m = pd.DataFrame(raw_data["metadatas"])
                g1, g2 = st.columns(2)
                with g1:
                    st.markdown("###### Eventos por IP de Origen")
                    st.bar_chart(df_m["src_ip"].value_counts() if "src_ip" in df_m else pd.Series())
                with g2:
                    st.markdown("###### Eventos por Tipo de Alerta")
                    st.bar_chart(df_m["event"].value_counts() if "event" in df_m else pd.Series())
            else:
                st.warning("Sin metadatas suficientes.")
        except Exception as e:
            st.error(f"Error generando gráficos: {e}")

with tab_explorer:
    st.markdown("##### 🔍 Búsqueda de Logs")
    filtro = st.text_input("Filtrar por palabra clave o IP:", "")
    if collection:
        try:
            raw = collection.get()
            if raw and raw.get("documents"):
                rows = [{"ID": i, "Log": d, "Meta": m} for d, m, i in zip(raw["documents"], raw["metadatas"], raw["ids"]) if not filtro or filtro.lower() in d.lower()]
                if rows:
                    st.dataframe(pd.DataFrame(rows), use_container_width=True)
                else:
                    st.warning("No hay coincidencias.")
        except Exception as e:
            st.error(f"Error: {e}")

